{
  "manifest_version": 3,
  "name": "Widget Adressage Patient",
  "version": "1.0.0",
  "description": "Widget d'adressage patient depuis Doctolib - Extension Chrome pour l'ophtalmologie",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.doctolib.fr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Widget Adressage Patient"
  },
  "content_scripts": [
    {
      "matches": ["https://*.doctolib.fr/*"],
      "js": ["js/content-script.js"],
      "css": ["css/content-inject.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
